#!/bin/bash
# Convenience wrapper: attach to the team-claude tmux session.
# Looks for the socket in the usual places — works from any container in the
# pod (devcontainer @ /home/devbox/.tmux-claude/socket, code-server @
# /tmux-host/socket via the PVC subPath mount).
set -e
for cand in "${TMUX_SOCKET:-}" /home/devbox/.tmux-claude/socket /tmux-host/socket; do
  if [ -n "$cand" ] && [ -S "$cand" ]; then
    exec tmux -S "$cand" attach -t claude-main
  fi
done
echo "claude-attach: no tmux-claude socket found (looked in TMUX_SOCKET, /home/devbox/.tmux-claude/socket, /tmux-host/socket)" >&2
exit 1
