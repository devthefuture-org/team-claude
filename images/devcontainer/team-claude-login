#!/bin/bash
# team-claude-login — wraps `claude` to prefer `setup-token` on first run.
#
# Why: the default `claude` interactive login opens an OAuth flow whose
# callback hits http://localhost:<random-port>/callback — that doesn't reach
# the user's browser when claude runs inside a remote pod. `claude setup-token`
# uses a code-paste flow that works from any browser anywhere.
set -e

CREDS="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/.credentials.json"

if [ ! -f "$CREDS" ] && ! [ -n "${ANTHROPIC_API_KEY:-}" ]; then
  cat <<'EOF'
═════════════════════════════════════════════════════════════════════════
  First-time login required.

  This pod runs remotely. Three working paths, easiest first:

  (1) Copy creds from your laptop (RECOMMENDED — bypasses all OAuth bugs):
      On your laptop:    $ claude login          # native OAuth, works
      Then from there:   $ tcl auth <session>    # copies ~/.claude/.credentials.json into the pod
      Back in this tmux: just type `claude` — it'll pick up the token.

  (2) `claude setup-token` (manual code-paste flow, but currently has a
      known scope bug — anthropics/claude-code#4540, may show "Paramètre
      scope manquant" in the browser; option 1 is more reliable today):
      $ claude setup-token

  (3) API key:
      $ export ANTHROPIC_API_KEY=sk-ant-...
      $ claude

  Do NOT run plain `claude` first — it'd try the OAuth-with-localhost
  callback that can't reach your browser from this pod.

═════════════════════════════════════════════════════════════════════════

EOF
  exec bash -l
fi

cat <<'EOF'
─────────────────────────────────────────────────────────────────────────
  team-claude — collaborative session ready.

  At your first prompt, launch a Monitor on the participants feed so
  Claude receives messages in real-time without you having to nudge:

      tail -F .team-claude/events.jsonl

  See CLAUDE.md (in the workspace root) for the full facilitation brief.
─────────────────────────────────────────────────────────────────────────

EOF

exec claude "$@"
