#!/usr/bin/env bash
# tcl — team-claude session helper. Wraps helm + kubectl for common ops.
#
# Usage: tcl <command> [args]
# Env:
#   TCL_NAMESPACE   (default: team-claude)
#   TCL_DOMAIN      (default: shared-coding-session.devthefuture.org)
#   TCL_CHART_DIR   (default: chart/team-claude, resolved relative to repo root)
#   TCL_IMAGE_PULL_SECRET  (default: empty; if set, --set imagePullSecrets[0].name=...)
#   KUBECONFIG      (standard)

set -euo pipefail

NS="${TCL_NAMESPACE:-team-claude}"
DOMAIN="${TCL_DOMAIN:-shared-coding-session.devthefuture.org}"
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
REPO_ROOT="$( cd "$SCRIPT_DIR/.." && pwd )"
CHART_DIR="${TCL_CHART_DIR:-$REPO_ROOT/chart/team-claude}"
IMAGE_PULL_SECRET="${TCL_IMAGE_PULL_SECRET:-}"

die()  { echo "tcl: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null || die "missing dependency: $1"; }

usage() {
  cat <<EOF
tcl — team-claude session helper

Commands:
  create <name> [--user U] [--repo URL] [--daemon] [--ssh]
                          Install a new session via Helm
  list                    List all team-claude releases in the namespace
  attach <name>           kubectl exec into the tmux/claude session
  auth <name> [path]      Copy ~/.claude/.credentials.json from this machine
                          into the pod (workaround for remote OAuth bugs).
                          Default path: \$HOME/.claude/.credentials.json
  url <name>              Print code-server URL + password
  room <name>             Print the admin/host URL (room token, free-form name)
  invite <name>           Mint a one-shot invite URL — participant picks a
                          pseudo on first open and gets their own token
  participants <name>     List participants (pseudo, joined/seen, revoked)
  revoke <name> <pseudo>  Revoke a participant's token + close their WS
  logs <name> [-c CT]     Tail logs of a container (default: devcontainer)
  destroy <name>          helm uninstall (PVC kept via Retain)
  purge <name>            destroy + delete PVC (DATA LOST)

Env:
  TCL_NAMESPACE=$NS
  TCL_DOMAIN=$DOMAIN
  TCL_CHART_DIR=$CHART_DIR
EOF
}

cmd_create() {
  local name="${1:-}"; shift || true
  [ -n "$name" ] || die "create requires <name>"
  local extra_args=()
  local user="" repo=""
  local daemon=false ssh=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --user) user="$2"; shift 2;;
      --repo) repo="$2"; shift 2;;
      --daemon) daemon=true; shift;;
      --ssh) ssh=true; shift;;
      *) extra_args+=("$1"); shift;;
    esac
  done
  local sets=(
    --set "session.name=$name"
    --set "domain=$DOMAIN"
    --set "devcontainer.image.tag=latest"
    --set "devcontainer.image.pullPolicy=Always"
  )
  [ -n "$user" ] && sets+=(--set "session.user=$user")
  [ -n "$repo" ] && sets+=(--set "session.repo=$repo")
  [ "$daemon" = true ] && sets+=(--set "daemon.enabled=true" --set "daemon.image.tag=latest" --set "daemon.image.pullPolicy=Always")
  [ "$ssh"    = true ] && sets+=(--set "ssh.enabled=true")
  [ -n "$IMAGE_PULL_SECRET" ] && sets+=(--set "imagePullSecrets[0].name=$IMAGE_PULL_SECRET")

  helm upgrade --install "session-$name" "$CHART_DIR" \
    --namespace "$NS" --create-namespace \
    "${sets[@]}" "${extra_args[@]}"

  echo
  echo "Session 'session-$name' deployed. Wait for the Pod to become Running:"
  echo "  kubectl get pod -n $NS session-$name-0 -w"
}

cmd_list() {
  helm list -n "$NS" -f '^session-'
}

cmd_attach() {
  local name="${1:-}"; [ -n "$name" ] || die "attach requires <name>"
  exec kubectl exec -it -n "$NS" "session-$name-0" -c devcontainer -- claude-attach
}

cmd_auth() {
  local name="${1:-}"; [ -n "$name" ] || die "auth requires <name>"
  local src="${2:-$HOME/.claude/.credentials.json}"
  [ -f "$src" ] || die "no credentials at $src — run 'claude login' on this machine first, then retry"
  local workspace="/home/devbox/workspace"

  echo "Copying $src → session-$name pod (/home/devbox/.claude/.credentials.json)…"
  kubectl exec -n "$NS" "session-$name-0" -c devcontainer -- \
    bash -c 'install -d -m 0700 /home/devbox/.claude'
  kubectl cp "$src" "$NS/session-$name-0:/home/devbox/.claude/.credentials.json" -c devcontainer
  kubectl exec -n "$NS" "session-$name-0" -c devcontainer -- \
    chmod 0600 /home/devbox/.claude/.credentials.json

  # Mark onboarding done + auto-trust the workspace so the welcome and
  # "trust this folder?" prompts don't reappear on every pod start (they
  # otherwise force the user through a full login flow on each device).
  echo "Marking onboarding+workspace-trust as accepted on the pod…"
  kubectl exec -n "$NS" "session-$name-0" -c devcontainer -- python3 -c "
import json, os
p = '/home/devbox/.claude/.claude.json'
d = json.load(open(p)) if os.path.exists(p) else {}
d['hasCompletedOnboarding'] = True
d.setdefault('lastOnboardingVersion', '2.1.150')
projects = d.setdefault('projects', {})
proj = projects.setdefault('$workspace', {})
proj['hasTrustDialogAccepted'] = True
proj.setdefault('hasClaudeMdExternalIncludesApproved', True)
tmp = p + '.tmp'
os.umask(0o077)
json.dump(d, open(tmp, 'w'))
os.replace(tmp, p)
print('  hasCompletedOnboarding:', d['hasCompletedOnboarding'])
print('  projects[$workspace].hasTrustDialogAccepted:', proj['hasTrustDialogAccepted'])
"
  echo "✓ done. Auth + onboarding ready. Run 'tcl attach $name' to start Claude."
}

cmd_url() {
  local name="${1:-}"; [ -n "$name" ] || die "url requires <name>"
  local pwd_b64; pwd_b64=$(kubectl get secret -n "$NS" "session-$name-auth" -o jsonpath='{.data.codeServerPassword}')
  printf "URL:      https://code-%s.%s/\n" "$name" "$DOMAIN"
  printf "Password: %s\n" "$(echo "$pwd_b64" | base64 -d)"
}

cmd_room() {
  local name="${1:-}"; [ -n "$name" ] || die "room requires <name>"
  local url_b64; url_b64=$(kubectl get secret -n "$NS" "session-$name-auth" -o jsonpath='{.data.roomUrl}')
  echo "$(echo "$url_b64" | base64 -d)"
}

# Helpers for invite/participants/revoke — talk to the daemon's /admin/* HTTP
# endpoints over the public ingress, gated by the room token from the Secret.
_session_token() {
  local name="$1"
  kubectl get secret -n "$NS" "session-$name-auth" -o jsonpath='{.data.roomToken}' | base64 -d
}
_session_base_url() {
  local name="$1"
  echo "https://team-$name.$DOMAIN"
}

cmd_invite() {
  local name="${1:-}"; [ -n "$name" ] || die "invite requires <name>"
  local tok base
  tok=$(_session_token "$name")
  base=$(_session_base_url "$name")
  [ -n "$tok" ] || die "no room token found for session-$name (is the daemon enabled?)"
  local resp; resp=$(curl -fsS -X POST "$base/admin/invite?token=$tok") || die "POST $base/admin/invite failed"
  local code; code=$(echo "$resp" | python3 -c 'import sys,json; print(json.load(sys.stdin)["code"])')
  printf "Invite URL (single-use, one pseudo chosen on first open):\n"
  printf "  %s/invite/%s\n" "$base" "$code"
}

cmd_participants() {
  local name="${1:-}"; [ -n "$name" ] || die "participants requires <name>"
  local tok base
  tok=$(_session_token "$name"); base=$(_session_base_url "$name")
  [ -n "$tok" ] || die "no room token found for session-$name"
  curl -fsS "$base/admin/participants?token=$tok" | \
    python3 -c '
import sys, json
d = json.load(sys.stdin)["participants"]
if not d:
    print("(aucun participant)")
    sys.exit(0)
print(f"{\"PSEUDO\":<24} {\"JOINED\":<20} {\"LAST SEEN\":<20} STATE")
for p in sorted(d, key=lambda x: x["joinedAt"]):
    state = "revoked@" + p["revokedAt"] if p.get("revokedAt") else "active"
    print(f"{p[\"pseudo\"]:<24} {p[\"joinedAt\"][:19]:<20} {p[\"lastSeenAt\"][:19]:<20} {state}")
'
}

cmd_revoke() {
  local name="${1:-}" pseudo="${2:-}"
  [ -n "$name" ]   || die "revoke requires <name> <pseudo>"
  [ -n "$pseudo" ] || die "revoke requires <name> <pseudo>"
  local tok base
  tok=$(_session_token "$name"); base=$(_session_base_url "$name")
  [ -n "$tok" ] || die "no room token found for session-$name"
  curl -fsS -X POST --data-urlencode "pseudo=$pseudo" "$base/admin/revoke?token=$tok" | \
    python3 -c 'import sys, json; r = json.load(sys.stdin); print("✓ revoked:" if r.get("ok") else "✗ error:", r)'
}

cmd_logs() {
  local name="${1:-}"; shift || true
  [ -n "$name" ] || die "logs requires <name>"
  local container="devcontainer"
  while [ $# -gt 0 ]; do
    case "$1" in
      -c|--container) container="$2"; shift 2;;
      *) shift;;
    esac
  done
  exec kubectl logs -f -n "$NS" "session-$name-0" -c "$container"
}

cmd_destroy() {
  local name="${1:-}"; [ -n "$name" ] || die "destroy requires <name>"
  helm uninstall "session-$name" -n "$NS"
  echo "Destroyed. PVC 'session-$name-data' preserved (Retain). Use 'tcl purge $name' to also delete the data."
}

cmd_purge() {
  local name="${1:-}"; [ -n "$name" ] || die "purge requires <name>"
  read -r -p "About to PERMANENTLY DELETE session-$name AND its data. Type the name to confirm: " confirm
  [ "$confirm" = "$name" ] || die "aborted"
  helm uninstall "session-$name" -n "$NS" 2>/dev/null || true
  kubectl delete pvc -n "$NS" "session-$name-data" --ignore-not-found
}

need helm
need kubectl

cmd="${1:-}"
shift || true
case "$cmd" in
  create)       cmd_create       "$@";;
  list)         cmd_list         "$@";;
  attach)       cmd_attach       "$@";;
  auth)         cmd_auth         "$@";;
  url)          cmd_url          "$@";;
  room)         cmd_room         "$@";;
  invite)       cmd_invite       "$@";;
  participants) cmd_participants "$@";;
  revoke)       cmd_revoke       "$@";;
  logs)         cmd_logs         "$@";;
  destroy)      cmd_destroy      "$@";;
  purge)        cmd_purge        "$@";;
  ""|help|-h|--help) usage;;
  *) usage; exit 2;;
esac
